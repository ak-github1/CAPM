PROCEDURE "VALIDATE_AND_LOG_VANSTOCK" (
    IN  IT_ROWS        "TT_VANSTOCK_ROWS",
    IN  UPLOADED_BY     NVARCHAR(40),
    IN  UPLOADED_ON     TIMESTAMP,
    OUT ET_SUMMARY      TABLE (SUCCESS_COUNT INTEGER, FAIL_COUNT INTEGER)
)
LANGUAGE SQLSCRIPT
SQL SECURITY INVOKER
AS
BEGIN
    DECLARE VALIDATED_ROWS TABLE (
        ID NVARCHAR(36), ROWNUMBER INTEGER, ENGINEERID NVARCHAR(20),
        PROFITCENTER NVARCHAR(10), PARTNUMBER NVARCHAR(40),
        QUANTITY DECIMAL(13,3), VALUE DECIMAL(15,2),
        STATUS NVARCHAR(10), REMARK NVARCHAR(200)
    );

    VALIDATED_ROWS =
        SELECT
            TO_NVARCHAR(SYSUUID) AS ID,
            R.ROWNUMBER, R.ENGINEERID, R.PROFITCENTER, R.PARTNUMBER,
            R.QUANTITY, R.VALUE,
            CASE
                WHEN R.ENGINEERID IS NULL OR R.PROFITCENTER IS NULL OR R.PARTNUMBER IS NULL
                    THEN 'Failed'
                WHEN NOT EXISTS (SELECT 1 FROM "VANSTOCK_PROFITCENTERS" PC
                                  WHERE PC.PROFITCENTER = R.PROFITCENTER AND PC.STATUS = 'A')
                    THEN 'Failed'
                WHEN NOT EXISTS (SELECT 1 FROM "VANSTOCK_MATERIALS" M
                                  WHERE M.MATERIALNUMBER = R.PARTNUMBER AND M.STATUS = 'A')
                    THEN 'Failed'
                WHEN R.QUANTITY IS NULL OR R.QUANTITY <= 0
                    THEN 'Failed'
                WHEN R.VALUE IS NULL OR R.VALUE < 0
                    THEN 'Failed'
                ELSE 'Success'
            END AS STATUS,
            CASE WHEN R.ENGINEERID IS NULL THEN 'Engineer ID required; ' ELSE '' END ||
            CASE WHEN NOT EXISTS (SELECT 1 FROM "VANSTOCK_PROFITCENTERS" PC
                                   WHERE PC.PROFITCENTER = R.PROFITCENTER AND PC.STATUS = 'A')
                 THEN 'Profit Center invalid/inactive; ' ELSE '' END ||
            CASE WHEN NOT EXISTS (SELECT 1 FROM "VANSTOCK_MATERIALS" M
                                   WHERE M.MATERIALNUMBER = R.PARTNUMBER AND M.STATUS = 'A')
                 THEN 'Part Number invalid/inactive; ' ELSE '' END AS REMARK
        FROM :IT_ROWS AS R;

    -- 1. Log EVERY row (pass and fail)
    INSERT INTO "VANSTOCK_UPLOADLOGS"
        (ID, UPLOADEDON, UPLOADEDBY, ROWNUMBER, ENGINEERID, PROFITCENTER,
         PARTNUMBER, QUANTITY, VALUE, STATUS, REMARK, POSTED)
    SELECT
        ID, :UPLOADED_ON, :UPLOADED_BY, ROWNUMBER, ENGINEERID, PROFITCENTER,
        PARTNUMBER, QUANTITY, VALUE, STATUS, REMARK,
        CASE WHEN STATUS = 'Success' THEN TRUE ELSE FALSE END
    FROM :VALIDATED_ROWS;

    -- 2. Commit successful rows directly into VanStockProfiles
    INSERT INTO "VANSTOCK_VANSTOCKPROFILES"
        (ID, CREATEDON, ENGINEERID, PROFITCENTER, PARTNUMBER, QUANTITY, VALUE)
    SELECT
        TO_NVARCHAR(SYSUUID), CURRENT_DATE, ENGINEERID, PROFITCENTER, PARTNUMBER, QUANTITY, VALUE
    FROM :VALIDATED_ROWS
    WHERE STATUS = 'Success';

    ET_SUMMARY =
        SELECT
            SUM(CASE WHEN STATUS = 'Success' THEN 1 ELSE 0 END) AS SUCCESS_COUNT,
            SUM(CASE WHEN STATUS = 'Failed' THEN 1 ELSE 0 END) AS FAIL_COUNT
        FROM :VALIDATED_ROWS;
END;